									{
										"id": "000002c",
										"elType": "widget",
										"widgetType": "text-editor",
										"settings": {
											"editor": "<p>We go to one place, one kitchen and one workshop for each issue, and we stay longer than is sensible. Nothing is written from a press release, and nobody we write about pays to be in the magazine.</p><p>When the stories are set, we spread the proofs over the big table and mark them by hand, as in the picture above. A sentence that cannot be read aloud without stumbling is rewritten.</p><p>There is no advertising. The magazine is paid for by the people who read it, which is the only arrangement we have found that lets us write what we saw.</p>",
											"typography_typography": "custom",
											"typography_font_size": {
												"unit": "px",
												"size": 18,
												"sizes": []
											}
										},
