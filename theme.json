{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "960px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"link": true,
			"palette": [
				{
					"slug": "primary",
					"color": "#3f4cd6",
					"name": "Primary"
				},
				{
					"slug": "primary-dark",
					"color": "#2b36b8",
					"name": "Primary dark"
				},
				{
					"slug": "secondary",
					"color": "#14b8a6",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f5a623",
					"name": "Accent"
				},
				{
					"slug": "heading",
					"color": "#0f172a",
					"name": "Heading"
				},
				{
					"slug": "text",
					"color": "#334155",
					"name": "Body text"
				},
				{
					"slug": "muted",
					"color": "#64748b",
					"name": "Muted"
				},
				{
					"slug": "border",
					"color": "#e2e8f0",
					"name": "Border"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "background",
					"color": "#f8fafc",
					"name": "Background"
				},
				{
					"slug": "dark",
					"color": "#0f172a",
					"name": "Dark"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"slug": "body",
					"name": "Hanken Grotesk",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/hanken-grotesk-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/hanken-grotesk-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.125rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "Extra large"
				},
				{
					"slug": "xx-large",
					"size": "2rem",
					"name": "Huge"
				},
				{
					"slug": "display",
					"size": "clamp(2.25rem, 1.4rem + 3.6vw, 3.25rem)",
					"name": "Display"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "1"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "2"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "3"
				},
				{
					"slug": "50",
					"size": "2rem",
					"name": "4"
				},
				{
					"slug": "60",
					"size": "3rem",
					"name": "5"
				},
				{
					"slug": "70",
					"size": "4rem",
					"name": "6"
				},
				{
					"slug": "80",
					"size": "clamp(4rem, 2.5rem + 6vw, 6rem)",
					"name": "7"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--of-color-bg, #f8fafc)",
			"text": "var(--of-color-text, #334155)"
		},
		"typography": {
			"fontFamily": "var(--of-font-body)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--of-color-heading, #0f172a)"
				},
				"typography": {
					"fontFamily": "var(--of-font-heading)",
					"fontWeight": "var(--of-fw-heading, 700)"
				}
			},
			"link": {
				"color": {
					"text": "var(--of-color-link, #3f4cd6)"
				},
				":hover": {
					"color": {
						"text": "var(--of-color-link-hover, #2b36b8)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--of-color-primary, #3f4cd6)",
					"text": "#ffffff"
				},
				"border": {
					"radius": "10px"
				},
				":hover": {
					"color": {
						"background": "var(--of-color-primary-hover, #2b36b8)"
					}
				}
			}
		}
	}
}
